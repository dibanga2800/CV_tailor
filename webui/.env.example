# Copy to webui/.env (the repo .gitignore already ignores .env files).
# Option A: Anthropic API key (pay per token). Leave unset to use Claude Code instead.
# ANTHROPIC_API_KEY=sk-ant-...

# auto (default) | claude | codex | grok | cursor | deepseek | openai | anthropic | mock
# CV_TAILOR_ENGINE=auto
# CV_TAILOR_ENGINE_TIMEOUT=240
# CV_TAILOR_REQUEST_TIMEOUT=540
# GROK_MODEL=grok-4.7-build-fast
# GROK_REASONING_EFFORT=low

# Model override. API default: claude-sonnet-5-5
# CV_TAILOR_MODEL=claude-opus-5-5

# CV_TAILOR_PORT=8765

# Job scanner (Find jobs tab). Free keys: reed.co.uk/developers, developer.adzuna.com
# REED_API_KEY=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Optional: Enhancv Business plan API key (Download > Send to Enhancv)
# ENHANCV_API_KEY=
